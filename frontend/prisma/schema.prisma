generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum ClaimStatus {
  unclaimed
  pending
  verified
}

enum ProfileClaimRequestStatus {
  pending
  approved
  rejected
}

enum RankingEngine {
  mbb
  baseball_tiered
  composite
  clippd_golf
}

model User {
  id                 String   @id @default(cuid())
  email              String?  @unique
  passwordHash       String?
  name               String?
  role               UserRole @default(user)
  stripeCustomerId   String?  @unique
  subscriptionActive Boolean  @default(false)
  createdAt          DateTime @default(now())

  claimedAthletes      Athlete[]             @relation("ClaimedAthletes")
  profileClaimRequests ProfileClaimRequest[]
}

model ProSubscription {
  id                   String   @id @default(cuid())
  stripeCustomerId     String   @unique
  stripeSubscriptionId String?
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stripeCustomerId, status])
}

model Sport {
  id            String        @id @default(cuid())
  code          String        @unique
  label         String
  sidearmPath   String?
  rankingEngine RankingEngine @default(composite)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  seasons           Season[]
  teams             Team[]
  conferenceSeasons ConferenceSeason[]
  rankingSnapshots  RankingSnapshot[]
}

model Conference {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  region String?

  teams             Team[]
  athleteSeasons    AthleteSeason[]
  conferenceSeasons ConferenceSeason[]
}

model Season {
  id        String  @id @default(cuid())
  label     String
  sportId   String
  sport     Sport   @relation(fields: [sportId], references: [id], onDelete: Cascade)
  startYear Int?
  endYear   Int?
  isCurrent Boolean @default(false)

  athleteSeasons    AthleteSeason[]
  teams             Team[]
  conferenceSeasons ConferenceSeason[]
  rankingSnapshots  RankingSnapshot[]

  @@unique([sportId, label])
  @@index([sportId, isCurrent])
}

model Team {
  id               String      @id @default(cuid())
  slug             String
  name             String
  sportId          String
  sport            Sport       @relation(fields: [sportId], references: [id], onDelete: Cascade)
  conferenceId     String?
  conference       Conference? @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  seasonId         String?
  season           Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  externalSchoolId String?
  shortName        String?
  logoUrl          String?

  athleteSeasons AthleteSeason[]
  seasonStat     TeamSeasonStat?

  @@unique([sportId, seasonId, slug])
  @@index([conferenceId])
  @@index([sportId, name])
}

/// Aggregated team statistics plus persisted rating/rank output for one Team row
/// (Team is already scoped to sport + season). Record and efficiency fields are
/// nullable because the current pipeline has no game results; they are reserved
/// for when a results source is added.
model TeamSeasonStat {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  gamesPlayed       Int?
  rosterCount       Int?
  rankedPlayerCount Int?

  pointsPerGame    Float?
  reboundsPerGame  Float?
  assistsPerGame   Float?
  turnoversPerGame Float?
  stealsPerGame    Float?
  blocksPerGame    Float?
  fieldGoalPct     Float?
  threePointPct    Float?
  freeThrowPct     Float?

  wins                 Int?
  losses               Int?
  conferenceWins       Int?
  conferenceLosses     Int?
  pointsAllowedPerGame Float?
  offensiveRating      Float?
  defensiveRating      Float?
  strengthOfSchedule   Float?

  rating               Float?
  rawStrength          Float?
  nationalRank         Int?
  conferenceRank       Int?
  previousNationalRank Int?
  ratingVersion        String?
  extra                Json?
  computedAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([rating(sort: Desc)])
  @@index([nationalRank])
}

/// Conference strength for one sport + season, derived from its teams' ratings.
model ConferenceSeason {
  id           String     @id @default(cuid())
  conferenceId String
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  sportId      String
  sport        Sport      @relation(fields: [sportId], references: [id], onDelete: Cascade)
  seasonId     String
  season       Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  teamCount            Int
  rankedTeamCount      Int?
  avgTeamRating        Float?
  medianTeamRating     Float?
  topTeamRating        Float?
  top3AvgRating        Float?
  teamsInTop25         Int?
  rating               Float?
  nationalRank         Int?
  previousNationalRank Int?
  ratingVersion        String?
  computedAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([conferenceId, seasonId])
  @@index([seasonId, nationalRank])
}

enum RankingEntityType {
  team
  conference
  player
}

/// Immutable ordered output of one ranking run. Enables rank movement and audits
/// once more than one snapshot exists per season.
model RankingSnapshot {
  id         String            @id @default(cuid())
  sportId    String
  sport      Sport             @relation(fields: [sportId], references: [id], onDelete: Cascade)
  seasonId   String
  season     Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  entityType RankingEntityType
  version    String
  entries    Json
  computedAt DateTime          @default(now())

  @@index([seasonId, entityType, computedAt(sort: Desc)])
}

model Athlete {
  id              String      @id @default(cuid())
  slug            String      @unique
  displayName     String
  firstName       String?
  lastName        String?
  claimStatus     ClaimStatus @default(unclaimed)
  claimedByUserId String?
  claimedByUser   User?       @relation("ClaimedAthletes", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  externalIds          AthleteExternalId[]
  seasons              AthleteSeason[]
  profileViews         ProfileView[]
  profileClaimRequests ProfileClaimRequest[]

  @@index([displayName])
}

model AthleteExternalId {
  id         String  @id @default(cuid())
  athleteId  String
  athlete    Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  source     String
  externalId String

  @@unique([source, externalId])
  @@index([athleteId])
}

model AthleteSeason {
  id              String      @id @default(cuid())
  athleteId       String
  athlete         Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  seasonId        String
  season          Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  conferenceId    String?
  conference      Conference? @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  position        String?
  classYear       String?
  segment         String      @default("")
  globalRank      Int?
  rating          Int?
  compositeScore  Float?
  stats           Json
  eligibilityMeta Json?
  sourceRank      Int?
  dataSource      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  aiSummary AiPlayerSummary?

  @@unique([athleteId, seasonId, segment])
  @@index([seasonId, globalRank])
  @@index([seasonId, rating(sort: Desc)])
  @@index([teamId])
  @@index([conferenceId])
}

model ProfileView {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sessionId String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([athleteId, createdAt])
}

model AiPlayerSummary {
  id              String        @id @default(cuid())
  athleteSeasonId String        @unique
  athleteSeason   AthleteSeason @relation(fields: [athleteSeasonId], references: [id], onDelete: Cascade)
  model           String
  summaryMarkdown String        @db.Text
  generatedAt     DateTime      @default(now())
}

model ProfileClaimRequest {
  id        String                    @id @default(cuid())
  athleteId String
  athlete   Athlete                   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  message   String?
  status    ProfileClaimRequestStatus @default(pending)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([athleteId, status])
  @@index([email])
}
